0:["UDGQnekqriJNlJFPQ5EkI",[[["",{"children":["colleges",{"children":[["id","iit-bombay","d"],{"children":["__PAGE__?{\"id\":\"iit-bombay\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["colleges",{"children":[["id","iit-bombay","d"],{"children":["__PAGE__",{},[["$L1",["$","$L2",null,{"college":{"id":"iit-bombay","name":"IIT Bombay","shortName":"IITB","location":"Mumbai, Maharashtra","state":"Maharashtra","type":"Government","streams":["Engineering","Technology","Science"],"exams":["JEE Advanced"],"ranking":{"nirf":3,"qs":118,"times":251},"rating":4.8,"totalRating":2840,"fees":{"min":200000,"max":280000,"annual":240000},"placement":{"avg":2100000,"highest":25000000,"rate":97,"median":1800000},"campusSize":"550 acres","established":1958,"accreditation":["NBA","NAAC A++"],"facilities":["Central Library","Olympic Pool","Research Labs","Hostels","Medical Center","Innovation Cell"],"topRecruiters":["Google","Microsoft","Goldman Sachs","McKinsey","Amazon","Intel"],"image":"https://images.unsplash.com/photo-1562774053-701939374585?w=900&q=80","gallery":["https://images.unsplash.com/photo-1498243691581-b145c3f54a5a?w=800&q=80","https://images.unsplash.com/photo-1541339907198-e08756dedf3f?w=800&q=80","https://images.unsplash.com/photo-1580582932707-520aed937b7b?w=800&q=80","https://images.unsplash.com/photo-1571260899304-425eee4c7efc?w=800&q=80"],"description":"Indian Institute of Technology Bombay is one of India's premier engineering institutions, consistently ranked among the top universities in Asia. Founded in 1958, IIT Bombay is known for its cutting-edge research, world-class faculty, and exceptional alumni network spanning global technology and business leaders. The institute runs over 50 academic programmes and is home to 14 departments, 16 centres of excellence, and a thriving startup ecosystem.","highlights":["#3 in NIRF 2024","550-acre Green Campus","97% Placement Rate","QS World Rank 118"],"courses":[{"name":"B.Tech Computer Science & Engineering",